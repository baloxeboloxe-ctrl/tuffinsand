local function isSameTeam(player)

    if not player or player == LocalPlayer then

        return true

    end

    if LocalPlayer.Team and player.Team and LocalPlayer.Team == player.Team then

        return true

    end

    local success1, lAttr = pcall(function() return LocalPlayer:GetAttribute("Team") or LocalPlayer:GetAttribute("Faction") end)

    local success2, pAttr = pcall(function() return player:GetAttribute("Team") or player:GetAttribute("Faction") end)

    if success1 and success2 and lAttr ~= nil and pAttr ~= nil and lAttr == pAttr then

        return true

    end

    local char = player.Character

    local localChar = LocalPlayer.Character

    if char and localChar then

        if char.Parent and localChar.Parent and char.Parent == localChar.Parent and char.Parent ~= Workspace then

            return true

        end

    end

    return false

end

local function getTarget()

    local camera = Workspace.CurrentCamera

    if not camera then return nil end

    local closestPart = nil

    local closestDistance = Config.FOV

    local screenCenter = camera.ViewportSize / 2

    for _, player in ipairs(Players:GetPlayers()) do

        local character = player.Character

        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        local canTarget = player ~= LocalPlayer

            and character ~= nil

            and humanoid ~= nil

            and humanoid.Health > 0

            and not (Config.TeamCheck and isSameTeam(player))

        if canTarget then

            local part = nil

            pcall(function()

                part = character:FindFirstChild(Config.AimPart)

                    or character:FindFirstChild("Head")

                    or character:FindFirstChild("UpperTorso")

                    or character:FindFirstChild("HumanoidRootPart")

            end)

            if part then

                local targetPosition = part.Position

                local rootPart = character:FindFirstChild("HumanoidRootPart")

                if Config.Prediction and rootPart then

                    targetPosition = targetPosition + (rootPart.AssemblyLinearVelocity * 0.08)

                end

                local screenPosition, onScreen = camera:WorldToViewportPoint(targetPosition)

                if onScreen then

                    local distance = (Vector2.new(screenPosition.X, screenPosition.Y) - screenCenter).Magnitude

                    if distance < closestDistance then

                        closestDistance = distance

                        closestPart = part

                    end

                end

            end

        end

    end

    return closestPart

end

local function isAimKeyDown()

    local keyName = tostring(Config.AimKey or "")

    if keyName == "MouseRight" or keyName == "MouseButton2" then

        return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2)

    elseif keyName == "MouseLeft" or keyName == "MouseButton1" then

        return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)

    end

    local keyCode = Enum.KeyCode[keyName]

    if keyCode and keyCode ~= Enum.KeyCode.Unknown then

        return UserInputService:IsKeyDown(keyCode)

    end

    return false

end

