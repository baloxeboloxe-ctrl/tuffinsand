-- Appearance Tab

local ThemeSection = AppearanceTab:AddSection("Colors & Theme", "solar/palette-bold")

Controls.Theme = ThemeSection:AddDropdown("UniTheme", {

    Title = "Theme Preset",

    Description = "Select one of the available FluentPro themes.",

    Icon = "solar/palette-bold",

    Values = Fluent.Themes,

    Default = CUSTOM_THEME_NAME,

    Multi = false,

    Animated = true,

    DropdownOutsideWindow = false,

    Callback = function(value)

        if value == CUSTOM_THEME_NAME then

            applyCustomTheme()

        else

            Fluent:SetTheme(value)

        end

        task.defer(function()

            if runtimeAlive and Controls.Theme and Controls.Theme.Opened then

                Controls.Theme:Close()

            end

        end)

    end,

})

makeDropdownClosable(Controls.Theme)

Controls.Accent = ThemeSection:AddColorpicker("UniAccent", {

    Title = "Custom Accent Color",

    Description = "Changes borders, icons, sliders, and buttons.",

    Icon = "solar/pipette-bold",

    Default = DEFAULT_ACCENT,

    Transparency = 0,

    Callback = function(color)

        Appearance.Accent = color

        applyCustomTheme()

    end,

})

local BackgroundSection = AppearanceTab:AddSection("Background", "solar/gallery-bold")

Controls.BackgroundPreset = BackgroundSection:AddDropdown("UniBackgroundPreset", {

    Title = "Background Preset",

    Description = "Select an image displayed inside the window.",

    Icon = "solar/gallery-wide-bold",

    Values = BackgroundNames,

    Default = "None",

    Multi = false,

    Animated = true,

    DropdownOutsideWindow = false,

    Callback = function(value)

        Appearance.Background = BackgroundPresets[value] or ""

        Appearance.ShowBackground = true

        applyCustomTheme()

        task.defer(function()

            if runtimeAlive and Controls.BackgroundPreset and Controls.BackgroundPreset.Opened then

                Controls.BackgroundPreset:Close()

            end

        end)

    end,

})

makeDropdownClosable(Controls.BackgroundPreset)

Controls.BackgroundAsset = BackgroundSection:AddInput("UniBackgroundAsset", {

    Title = "Custom Image ID",

    Description = "Enter an ID or rbxassetid://ID, then press Enter.",

    Icon = "solar/link-bold",

    Placeholder = "e.g. 136310484943077",

    Default = "",

    Callback = function(value)

        local normalized = normalizeAssetId(value)

        if normalized == nil then

            Fluent:Notify({

                Title = "Invalid ID",

                Content = "Enter a numeric Roblox image ID.",

                Type = "Error",

                Duration = 4,

            })

            return

        end

        Appearance.Background = normalized

        Appearance.ShowBackground = normalized ~= ""

        applyCustomTheme()

    end,

})

Controls.BackgroundTransparency = BackgroundSection:AddSlider("UniBackgroundTransparency", {

    Title = "Background Transparency",

    Description = "0 is fully visible, while 100 is completely transparent.",

    Icon = "solar/opacity-bold",

    Min = 0,

    Max = 100,

    Default = 18,

    Rounding = 0,

    Callback = function(value)

        Appearance.BackgroundTransparency = value / 100

        applyCustomTheme()

    end,

})

Controls.ShowBackground = BackgroundSection:AddToggle("UniShowBackground", {

    Title = "Show Background",

    Description = "Quickly hides or displays the selected image.",

    Icon = "solar/eye-bold",

    Default = true,

    Callback = function(value)

        Appearance.ShowBackground = value

        updateBackgroundVisibility()

    end,

})

local EffectsSection = AppearanceTab:AddSection("Window Effects", "solar/stars-bold")

Controls.Transparency = EffectsSection:AddToggle("UniTransparency", {

    Title = "Transparent Window",

    Description = "Makes the game slightly visible behind the menu.",

    Icon = "solar/layers-minimalistic-bold",

    Default = true,

    Callback = function(value)

        Appearance.Transparent = value

        Fluent:ToggleTransparency(value)

    end,

})

Controls.Acrylic = EffectsSection:AddToggle("UniAcrylic", {

    Title = "Acrylic Blur",

    Description = "Blurs the scene behind the window.",

    Icon = "solar/layers-bold",

    Default = true,

    Callback = function(value)

        Appearance.Acrylic = value

        Fluent:ToggleAcrylic(value)

    end,

})

Controls.Animation = EffectsSection:AddToggle("UniAnimation", {

    Title = "Animated Border",

    Description = "Enables the moving shine effect of the Uni Custom theme.",

    Icon = "solar/stars-bold",

    Default = true,

    Callback = function(value)

        Appearance.Animated = value

        applyCustomTheme()

    end,

})

EffectsSection:AddButton({

    Title = "Restore Uni Appearance",

    Description = "Resets colors, background, and effects to their defaults.",

    Icon = "solar/restart-bold",

    Callback = function()

        Appearance.Accent = DEFAULT_ACCENT

        Appearance.Background = ""

        Appearance.BackgroundTransparency = 0.18

        Appearance.ShowBackground = true

        Appearance.Animated = true

        Appearance.Acrylic = true

        Appearance.Transparent = true

        pcall(function() Controls.Theme:SetValue(CUSTOM_THEME_NAME) end)

        pcall(function() Controls.Accent:SetValueRGB(DEFAULT_ACCENT, 0) end)

        pcall(function() Controls.BackgroundPreset:SetValue("None") end)

        pcall(function() Controls.BackgroundAsset:SetValue("") end)

        pcall(function() Controls.BackgroundTransparency:SetValue(18) end)

        pcall(function() Controls.ShowBackground:SetValue(true) end)

        pcall(function() Controls.Transparency:SetValue(true) end)

        pcall(function() Controls.Acrylic:SetValue(true) end)

        pcall(function() Controls.Animation:SetValue(true) end)

        Fluent:ToggleTransparency(true)

        Fluent:ToggleAcrylic(true)

        applyCustomTheme()

        Fluent:Notify({

            Title = "Uni",

            Content = "The default Uni appearance has been restored.",

            Type = "Success",

            Duration = 4,

        })

    end,

})

local UnloadSection = SettingsTab:AddSection("Unload", "solar/power-bold")

UnloadSection:AddButton({ Title = "Unload Uni", Description = "Stops the script and removes the entire interface.", Callback = function() unloadUni() end })

Window:SelectTab(1)

Fluent:Notify({ Title = "Uni v1", Content = "Loaded successfully!", Duration = 3 })
