local ESPColorSection = ESPTab:AddSection("ESP Colors", "solar/palette-bold")

Controls.EnemyColor = ESPColorSection:AddColorpicker("UniEnemyColor", { Title = "Enemy Color", Default = DEFAULT_CONFIG.EnemyColor, Callback = function(c) Config.EnemyColor = c end })

