Controls.ESP = ESPMainSection:AddToggle("UniESP", { Title = "ESP Enabled", Default = DEFAULT_CONFIG.ESP, Callback = function(v) Config.ESP = v end })

Controls.ESPTeamHide = ESPMainSection:AddToggle("UniESPTeamHide", { Title = "Hide Team ESP", Default = DEFAULT_CONFIG.ESPTeamHide, Callback = function(v) Config.ESPTeamHide = v end })

Controls.ESPHighlight = ESPMainSection:AddToggle("UniESPHighlight", { Title = "Character Highlight", Default = DEFAULT_CONFIG.ESPHighlight, Callback = function(v) Config.ESPHighlight = v end })

