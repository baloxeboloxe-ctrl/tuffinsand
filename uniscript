local MenuSection = MainTab:AddSection("Menu Controls", "solar/keyboard-bold")

Controls.MinimizeKeybind = MenuSection:AddKeybind("UniMinimizeKey", {
    Title = "Minimize Key",
    Description = "Click the key field and press a new key to hide or restore the menu.",
    Icon = "solar/keyboard-bold",
    Default = "RightShift",
})

-- FluentPro now reads the current value from this control. After the user
-- selects another key, the previous key stops toggling the menu immediately.
Fluent.MinimizeKeybind = Controls.MinimizeKeybind

-- Aimbot Tab

local AimMainSection = AimbotTab:AddSection("Main Settings", "solar/target-bold")

Controls.Aimbot = AimMainSection:AddToggle("UniAimbot", { Title = "Aimbot", Default = DEFAULT_CONFIG.Aimbot, Callback = function(v) Config.Aimbot = v end })

Controls.TeamCheck = AimMainSection:AddToggle("UniTeamCheck", { Title = "Team Check", Default = DEFAULT_CONFIG.TeamCheck, Callback = function(v) Config.TeamCheck = v end })

Controls.Prediction = AimMainSection:AddToggle("UniPrediction", { Title = "Movement Prediction", Default = DEFAULT_CONFIG.Prediction, Callback = function(v) Config.Prediction = v end })

Controls.AimKey = AimMainSection:AddKeybind("UniAimKey", { Title = "Aim Key", Default = DEFAULT_CONFIG.AimKey })

Controls.AimKey:OnChanged(function() Config.AimKey = Controls.AimKey.Value end)

local AimTuningSection = AimbotTab:AddSection("Targeting & FOV", "solar/tuning-square-2-bold")

Controls.AimPart = AimTuningSection:AddDropdown("UniAimPart", { Title = "Aim Part", Values = { "Head", "UpperTorso", "HumanoidRootPart" }, Default = DEFAULT_CONFIG.AimPart, Multi = false, Callback = function(v) Config.AimPart = v end })

makeDropdownClosable(Controls.AimPart)

Controls.FOV = AimTuningSection:AddSlider("UniFOV", { Title = "FOV", Min = 50, Max = 500, Default = DEFAULT_CONFIG.FOV, Rounding = 0, Callback = function(v) Config.FOV = v end })

Controls.Smoothness = AimTuningSection:AddSlider("UniSmoothness", { Title = "Aim Speed", Min = 1, Max = 10, Default = 3, Rounding = 0, Callback = function(v) Config.Smoothness = v / 10 end })

Controls.ShowFOV = AimTuningSection:AddToggle("UniShowFOV", { Title = "Show FOV Circle", Default = DEFAULT_CONFIG.ShowFOV, Callback = function(v) Config.ShowFOV = v end })

Controls.FOVColor = AimTuningSection:AddColorpicker("UniFOVColor", { Title = "FOV Circle Color", Default = DEFAULT_CONFIG.FOVColor, Callback = function(c) Config.FOVColor = c; FOVCircle.Color = c end })

